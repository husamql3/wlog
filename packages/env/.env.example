# Neon pooled connection (runtime queries).
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon direct connection (Prisma migrations). Same host without -pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth. Generate a fresh 32+ char secret for each environment.
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000

# CORS allowlist (web origin).
CORS_ORIGIN=http://localhost:3001

# Public: where the web app calls the server.
VITE_SERVER_URL=http://localhost:3000
