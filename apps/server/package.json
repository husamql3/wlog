{
	"name": "@wlog/server",
	"type": "module",
	"main": "src/app.ts",
	"exports": {
		".": "./src/app.ts"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/dev.ts --outfile server",
		"deploy": "vercel deploy ../.. --local-config ../../apps/server/vercel.json --yes",
		"deploy:prod": "bun run deploy --prod",
		"dev": "bun --env-file=../../packages/env/.env --hot src/dev.ts",
		"start": "bun --env-file=../../packages/env/.env dist/dev.mjs",
		"test": "bun test src",
		"trigger:dev": "npx trigger.dev@latest dev",
		"trigger:deploy": "npx trigger.dev@latest deploy"
	},
	"dependencies": {
		"@ai-sdk/google": "^3.0.75",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/eden": "^1.4.9",
		"@sinclair/typebox": "^0.34.49",
		"@trigger.dev/sdk": "4.4.6",
		"@wlog/auth": "workspace:*",
		"@wlog/db": "workspace:*",
		"@wlog/env": "workspace:*",
		"ai": "^6.0.184",
		"better-auth": "catalog:",
		"elysia": "^1.4.28",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@trigger.dev/build": "4.4.6",
		"@types/bun": "catalog:",
		"@wlog/config": "workspace:*",
		"tsdown": "^0.21.9",
		"typescript": "catalog:"
	}
}
