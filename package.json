{
	"name": "wlog",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/bun": "^1.3.4",
			"better-auth": "1.6.9",
			"next-themes": "^0.4.6",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"test": "turbo test",
		"dev:web": "turbo -F web dev",
		"dev:tui": "turbo -F tui dev",
		"dev:server": "turbo -F server dev",
		"db:generate": "bun --filter @wlog/db db:generate",
		"db:migrate:dev": "bun --filter @wlog/db db:migrate:dev",
		"db:migrate:deploy": "bun --filter @wlog/db db:migrate:deploy",
		"db:push": "bun --filter @wlog/db db:push",
		"db:studio": "bun --filter @wlog/db db:studio",
		"db:validate": "bun --filter @wlog/db db:validate",
		"vercel:dev": "bun --env-file=packages/env/.env run vercel dev --yes",
		"deploy": "vercel deploy --local-config apps/server/vercel.json --yes",
		"deploy:prod": "bun run deploy --prod",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@wlog/env": "workspace:*",
		"dotenv": "^17.4.2",
		"elysia": "^1.4.28",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.3.14",
		"@wlog/config": "workspace:*",
		"lefthook": "^2.1.6",
		"turbo": "^2.9.14",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.7"
}
